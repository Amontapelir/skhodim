PORT=3000
DATABASE_URL=postgres://skhodim:skhodim@localhost:5433/skhodim
# Домен(ы) фронтенда через запятую, или "*" для разработки.
CORS_ORIGIN=*

# test | proculture | kudago
# kudago — бесплатный публичный API kudago.com/public-api, без партнёрского
# ключа, основной источник для MVP (доступ к PRO.Культура.РФ не получен).
EVENT_SOURCE=kudago

# Ключ партнёра PRO.Культура.РФ (письмо от partners@team.culture.ru). См. README.
PRO_CULTURE_API_KEY=[PRO_CULTURE_API_KEY]
# Базовый URL и путь к событиям — из документации, выданной вместе с ключом.
PRO_CULTURE_API_BASE_URL=[PRO_CULTURE_API_BASE_URL]
PRO_CULTURE_EVENTS_PATH=/events

# mock | max
BOT_ADAPTER=mock
# Токен бота MAX. См. README.
MAX_BOT_TOKEN=[MAX_BOT_TOKEN]
