# Ключ Яндекс.Карт JS API — для карты в мини-приложении.
# Получить: https://developer.tech.yandex.ru/services/ (JavaScript API,
# бесплатный тариф). Без ключа карта скрыта — приложение работает и без него
# ("Время в пути" не зависит от этого ключа, это офлайн-оценка).
VITE_YANDEX_MAPS_API_KEY=[YANDEX_MAPS_API_KEY]
